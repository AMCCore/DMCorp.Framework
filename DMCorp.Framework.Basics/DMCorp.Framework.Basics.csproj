<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageId>DMCorp.Framework.Basics</PackageId>
		<Authors>Albert Shtradman</Authors>
		<Company>DMCorp</Company>
		<Product>DMCorp.Framework</Product>
		<PackageIcon>LogoBigYoutube.jpg</PackageIcon>
		<Title>DMCorp.Framework.Basics</Title>
		<PackageProjectUrl>https://github.com/AMCCore/DMCorp.Framework</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/AMCCore/DMCorp.Framework</RepositoryUrl>
		<PackageTags>c# .net</PackageTags>
		<Version>1.1.2.0</Version>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<AssemblyVersion>1.1.2.0</AssemblyVersion>
		<FileVersion>1.1.2.0</FileVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LogoBigYoutube.jpg">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.10" />
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.5" />
		<PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />
	</ItemGroup>

</Project>
